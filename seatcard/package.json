{
  "name": "seatcard",
  "version": "0.2.0",
  "description": "座次桌签：粘贴名单，自动排会议座次，一键打印双面桌签",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node tools/build.mjs",
    "smoke": "node tools/build.mjs && node tests/smoke.playwright.mjs",
    "serve": "python3 -m http.server 8766",
    "app": "node tools/build.mjs && electron .",
    "dist:win": "node tools/build.mjs && electron-builder --win --x64",
    "dist:mac": "node tools/build.mjs && electron-builder --mac",
    "dist:linux": "node tools/build.mjs && electron-builder --linux",
    "test:desktop": "node tools/build.mjs && node tests/desktop.playwright.mjs"
  },
  "license": "MIT",
  "author": "座次桌签",
  "homepage": "https://github.com/zryhandsome/auto-gpt/tree/claude/user-demand-research-qzl4la/seatcard",
  "main": "electron/main.cjs",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "resedit": "2.0.3"
  }
}
